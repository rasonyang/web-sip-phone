{
  "manifest_version": 3,
  "name": "Web SIP Phone",
  "version": "1.0.3",
  "description": "Keeps a WebRTC SIP extension registered over WSS and shows a headset button with live connection status on the pages you allow.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "offscreen", "scripting", "tabs"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
